{
  "name": "qa-automation-assessment",
  "version": "1.0.0",
  "description": "Task 4 Swag Labs UI automation using Playwright, TypeScript, BDD, and Page Object Models.",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:ui": "bddgen && playwright test --project=ui-chromium",
    "test:list": "bddgen && playwright test --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jason-Barron07/qa-automation-assessment.git"
  },
