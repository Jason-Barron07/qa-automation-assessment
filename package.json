{
  "name": "qa-automation-assessment",
  "version": "1.0.0",
  "description": "QA automation assessment using Playwright, TypeScript, and BDD. End-to-end testing with Page Object Models, data-driven scenarios, and test documentation.",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:api": "bddgen && playwright test --project=api",
    "test:ui": "bddgen && playwright test --project=ui-chromium",
    "test:list": "bddgen && playwright test --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jason-Barron07/qa-automation-assessment.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Jason-Barron07/qa-automation-assessment/issues"
  },
  "homepage": "https://github.com/Jason-Barron07/qa-automation-assessment#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "playwright-bdd": "^9.2.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
