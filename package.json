  },
  "homepage": "https://github.com/Jason-Barron07/qa-automation-assessment#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.3",
    "playwright-bdd": "^9.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
